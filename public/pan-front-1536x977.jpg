<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1536 977" width="100%" height="100%" style="border-radius:24px;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
  <defs>
    <!-- Background Gradient -->
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#d4e8f7"/>
      <stop offset="25%" stop-color="#e8f3fa"/>
      <stop offset="50%" stop-color="#f5e8f0"/>
      <stop offset="75%" stop-color="#dcecf7"/>
      <stop offset="100%" stop-color="#d0e2f2"/>
    </linearGradient>

    <!-- Guilloche Security Pattern -->
    <pattern id="securityWaves" width="80" height="40" patternUnits="userSpaceOnUse">
      <path d="M 0,20 Q 20,0 40,20 T 80,20" fill="none" stroke="#90b8dc" stroke-width="0.8" opacity="0.45"/>
      <path d="M 0,10 Q 20,30 40,10 T 80,10" fill="none" stroke="#d8a8ca" stroke-width="0.7" opacity="0.35"/>
      <path d="M 0,30 Q 20,10 40,30 T 80,30" fill="none" stroke="#8cb8e0" stroke-width="0.7" opacity="0.35"/>
      <circle cx="40" cy="20" r="12" fill="none" stroke="#b0cde8" stroke-width="0.6" opacity="0.4"/>
    </pattern>

    <!-- Center Emblem Watermark Filter -->
    <radialGradient id="watermarkGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Card Base -->
  <rect width="1536" height="977" rx="28" fill="url(#cardBg)"/>
  <rect width="1536" height="977" rx="28" fill="url(#securityWaves)"/>

  <!-- Subtle Outer Border -->
  <rect x="2" y="2" width="1532" height="973" rx="26" fill="none" stroke="#a0c2de" stroke-width="3"/>

  <!-- ================= TOP HEADER ================= -->
  <!-- Left Header: Income Tax Department -->
  <g id="header-left" transform="translate(60, 45)">
    <text x="0" y="38" font-size="44" font-weight="900" fill="#1b2e4b" font-family="'Mukta', 'Nirmala UI', sans-serif">
      आयकर विभाग
    </text>
    <text x="0" y="80" font-size="34" font-weight="800" fill="#1b2e4b" letter-spacing="1">
      INCOME TAX DEPARTMENT
    </text>
  </g>

  <!-- Center Header: National Emblem of India (Ashok Stambh) -->
  <g id="national-emblem" transform="translate(730, 22)">
    <!-- Ashoka Stambh simplified authentic vector -->
    <circle cx="38" cy="70" r="55" fill="url(#watermarkGlow)"/>
    
    <!-- Three Lions Base -->
    <path d="M 18,125 L 58,125 L 52,135 L 24,135 Z" fill="#245182"/>
    <rect x="15" y="112" width="46" height="13" rx="3" fill="#1e4672"/>
    <!-- Dharma Chakra in Emblem Base -->
    <circle cx="38" cy="118" r="5" fill="none" stroke="#ffffff" stroke-width="1.5"/>
    
    <!-- Central Lion -->
    <path d="M 28,45 C 28,32 48,32 48,45 C 52,55 52,75 48,88 L 28,88 C 24,75 24,55 28,45 Z" fill="#27568a"/>
    <circle cx="38" cy="38" r="9" fill="#2d64a0"/>
    <path d="M 32,32 Q 38,22 44,32" fill="none" stroke="#1d436c" stroke-width="2.5"/>
    <circle cx="35" cy="37" r="1.5" fill="#fff"/>
    <circle cx="41" cy="37" r="1.5" fill="#fff"/>

    <!-- Left Lion -->
    <path d="M 18,52 C 14,40 28,38 28,50 C 26,62 26,78 28,88 L 18,88 C 14,78 14,62 18,52 Z" fill="#204a77"/>
    <circle cx="21" cy="46" r="7" fill="#245385"/>

    <!-- Right Lion -->
    <path d="M 58,52 C 62,40 48,38 48,50 C 50,62 50,78 48,88 L 58,88 C 62,78 62,62 58,52 Z" fill="#204a77"/>
    <circle cx="55" cy="46" r="7" fill="#245385"/>

    <!-- Emblem Motto -->
    <text x="38" y="145" font-size="10" font-weight="bold" fill="#1e4672" text-anchor="middle" font-family="'Mukta', sans-serif">
      सत्यमेव जयते
    </text>
  </g>

  <!-- Right Header: Govt of India -->
  <g id="header-right" transform="translate(1476, 45)">
    <text x="0" y="38" font-size="44" font-weight="900" fill="#1b2e4b" text-anchor="end" font-family="'Mukta', 'Nirmala UI', sans-serif">
      भारत सरकार
    </text>
    <text x="0" y="80" font-size="34" font-weight="800" fill="#1b2e4b" text-anchor="end" letter-spacing="1">
      GOVT. OF INDIA
    </text>
  </g>

  <!-- Header Divider Glow Line -->
  <line x1="60" y1="155" x2="1476" y2="155" stroke="#a4c6e2" stroke-width="2.5" opacity="0.6"/>

  <!-- ================= MIDDLE SECTION: PERMANENT ACCOUNT NUMBER ================= -->
  <g id="pan-number-section" transform="translate(768, 205)">
    <text x="0" y="0" font-size="34" font-weight="800" fill="#28446c" text-anchor="middle" font-family="'Mukta', sans-serif">
      स्थायी लेखा संख्या
    </text>
    <text x="0" y="42" font-size="32" font-weight="700" fill="#28446c" text-anchor="middle">
      Permanent Account Number
    </text>
    <text x="0" y="112" font-size="58" font-weight="900" fill="#0d1b2e" text-anchor="middle" letter-spacing="5" font-family="'Courier New', Courier, monospace">
      ABCD12345F
    </text>
  </g>

  <!-- ================= LEFT: PASSPORT PORTRAIT PHOTO ================= -->
  <g id="photo-container" transform="translate(60, 185)">
    <!-- Photo Shadow & Border -->
    <rect x="0" y="0" width="280" height="360" rx="6" fill="#f0f4f8" stroke="#7599be" stroke-width="3"/>
    
    <clipPath id="photoClip">
      <rect x="3" y="3" width="274" height="354" rx="4"/>
    </clipPath>

    <!-- Embedded Portrait Photo matching uploaded user image -->
    <g clip-path="url(#photoClip)">
      <!-- Off-white background with subtle wall vignette -->
      <rect x="3" y="3" width="274" height="354" fill="#e9eef2"/>
      <circle cx="140" cy="160" r="140" fill="#f4f7f9"/>
      
      <!-- Body/Shoulders (Dark Crewneck Shirt) -->
      <path d="M 20,360 Q 30,260 90,240 Q 140,245 190,240 Q 250,260 260,360 Z" fill="#1a1c20"/>
      <path d="M 95,240 Q 140,255 185,240" fill="none" stroke="#0e1013" stroke-width="4"/>

      <!-- Neck & Collar Shadow -->
      <path d="M 115,200 L 115,245 Q 140,252 165,245 L 165,200 Z" fill="#b88365"/>
      <path d="M 120,225 Q 140,238 160,225" fill="#a46f53" opacity="0.6"/>

      <!-- Face & Head -->
      <ellipse cx="140" cy="155" rx="58" ry="72" fill="#c99575"/>
      <!-- Jawline -->
      <path d="M 88,140 Q 88,195 140,215 Q 192,195 192,140 Z" fill="#bf8a6a"/>

      <!-- Ears -->
      <ellipse cx="80" cy="155" rx="10" ry="18" fill="#be8a6c"/>
      <ellipse cx="200" cy="155" rx="10" ry="18" fill="#be8a6c"/>

      <!-- Hair (Short cropped dark hair) -->
      <path d="M 78,145 C 72,95 105,75 140,75 C 175,75 208,95 202,145 C 195,115 178,92 140,92 C 102,92 85,115 78,145 Z" fill="#131418"/>
      <path d="M 88,118 Q 140,105 192,118 Q 185,100 140,98 Q 95,100 88,118 Z" fill="#1a1a20"/>

      <!-- Eyebrows -->
      <path d="M 98,132 Q 118,126 130,132" fill="none" stroke="#1c1815" stroke-width="5" stroke-linecap="round"/>
      <path d="M 150,132 Q 162,126 182,132" fill="none" stroke="#1c1815" stroke-width="5" stroke-linecap="round"/>

      <!-- Eyes -->
      <ellipse cx="114" cy="144" rx="11" ry="8" fill="#fff"/>
      <circle cx="114" cy="144" r="5.5" fill="#2b1f1a"/>
      <circle cx="113" cy="142" r="1.8" fill="#fff"/>

      <ellipse cx="166" cy="144" rx="11" ry="8" fill="#fff"/>
      <circle cx="166" cy="144" r="5.5" fill="#2b1f1a"/>
      <circle cx="165" cy="142" r="1.8" fill="#fff"/>

      <!-- Nose -->
      <path d="M 140,138 L 137,168 L 140,172 L 143,168 Z" fill="#a87556"/>
      <path d="M 130,170 Q 140,175 150,170" fill="none" stroke="#8f5d41" stroke-width="3" stroke-linecap="round"/>

      <!-- Mouth & Lips -->
      <path d="M 124,190 Q 140,195 156,190" fill="none" stroke="#844d37" stroke-width="4.5" stroke-linecap="round"/>
      <path d="M 128,190 Q 140,186 152,190" fill="none" stroke="#aa654d" stroke-width="2.5"/>

      <!-- Subtle 5 o'clock shadow / stubble -->
      <path d="M 108,180 Q 140,210 172,180 Q 140,222 108,180 Z" fill="#5c4434" opacity="0.15"/>
    </g>
  </g>

  <!-- ================= LEFT DETAILS: NAME, DOB, SIGNATURE ================= -->
  <g id="personal-details" transform="translate(60, 580)">
    <!-- Name Label & Value -->
    <text x="0" y="30" font-size="34" font-weight="700" fill="#234268" font-family="'Mukta', sans-serif">
      नाम / Name
    </text>
    <text x="0" y="85" font-size="52" font-weight="900" fill="#0d1b2e" letter-spacing="1">
      Sample Kumar
    </text>

    <!-- DOB Label & Value -->
    <text x="0" y="155" font-size="34" font-weight="700" fill="#234268" font-family="'Mukta', sans-serif">
      जन्म तिथि / Date of Birth
    </text>
    <text x="0" y="210" font-size="52" font-weight="900" fill="#0d1b2e" letter-spacing="3" font-family="'Courier New', Courier, monospace">
      01/01/2002
    </text>

    <!-- Signature Label -->
    <text x="0" y="280" font-size="34" font-weight="700" fill="#234268" font-family="'Mukta', sans-serif">
      हस्ताक्षर / Signature :
    </text>
    <path d="M 330,270 Q 370,250 420,270 T 490,260 T 560,275" fill="none" stroke="#102542" stroke-width="3" stroke-linecap="round" opacity="0.85"/>
  </g>

  <!-- ================= RIGHT: HIGH FIDELITY QR CODE ================= -->
  <g id="qr-code-container" transform="translate(980, 395)">
    <!-- QR Outer White Backing -->
    <rect x="-15" y="-15" width="510" height="510" rx="8" fill="#ffffff" stroke="#90b4d8" stroke-width="2"/>
    
    <!-- Top-Left Position Detection Pattern -->
    <rect x="15" y="15" width="115" height="115" fill="#000000"/>
    <rect x="35" y="35" width="75" height="75" fill="#ffffff"/>
    <rect x="50" y="50" width="45" height="45" fill="#000000"/>

    <!-- Top-Right Position Detection Pattern -->
    <rect x="350" y="15" width="115" height="115" fill="#000000"/>
    <rect x="370" y="35" width="75" height="75" fill="#ffffff"/>
    <rect x="385" y="50" width="45" height="45" fill="#000000"/>

    <!-- Bottom-Left Position Detection Pattern -->
    <rect x="15" y="350" width="115" height="115" fill="#000000"/>
    <rect x="35" y="370" width="75" height="75" fill="#ffffff"/>
    <rect x="50" y="385" width="45" height="45" fill="#000000"/>

    <!-- Timing Patterns & Alignment Rects -->
    <g fill="#000000">
      <!-- Horizontal Timing -->
      <rect x="145" y="65" width="18" height="18"/>
      <rect x="185" y="65" width="18" height="18"/>
      <rect x="225" y="65" width="18" height="18"/>
      <rect x="265" y="65" width="18" height="18"/>
      <rect x="305" y="65" width="18" height="18"/>

      <!-- Vertical Timing -->
      <rect x="65" y="145" width="18" height="18"/>
      <rect x="65" y="185" width="18" height="18"/>
      <rect x="65" y="225" width="18" height="18"/>
      <rect x="65" y="265" width="18" height="18"/>
      <rect x="65" y="305" width="18" height="18"/>

      <!-- Authentic Grid Density Matrix -->
      <!-- Rows 1-3 -->
      <rect x="150" y="20" width="30" height="30"/>
      <rect x="210" y="20" width="30" height="60"/>
      <rect x="270" y="20" width="30" height="30"/>
      <rect x="150" y="100" width="60" height="30"/>
      <rect x="240" y="100" width="60" height="30"/>

      <!-- Rows 4-6 -->
      <rect x="20" y="150" width="30" height="60"/>
      <rect x="80" y="150" width="50" height="30"/>
      <rect x="150" y="150" width="40" height="40"/>
      <rect x="210" y="150" width="30" height="50"/>
      <rect x="260" y="150" width="50" height="30"/>
      <rect x="330" y="150" width="60" height="40"/>
      <rect x="410" y="150" width="50" height="50"/>

      <rect x="80" y="200" width="50" height="40"/>
      <rect x="150" y="210" width="40" height="50"/>
      <rect x="330" y="210" width="50" height="40"/>
      <rect x="400" y="220" width="60" height="40"/>

      <!-- Rows 7-9 -->
      <rect x="20" y="260" width="50" height="40"/>
      <rect x="90" y="260" width="40" height="50"/>
      <rect x="150" y="280" width="50" height="40"/>
      <rect x="320" y="270" width="60" height="50"/>
      <rect x="400" y="280" width="60" height="40"/>

      <!-- Rows 10-12 -->
      <rect x="150" y="340" width="40" height="40"/>
      <rect x="210" y="340" width="60" height="30"/>
      <rect x="290" y="340" width="40" height="50"/>
      <rect x="350" y="340" width="50" height="40"/>
      <rect x="420" y="340" width="40" height="40"/>

      <rect x="150" y="400" width="50" height="50"/>
      <rect x="220" y="390" width="50" height="60"/>
      <rect x="290" y="410" width="60" height="40"/>
      <rect x="370" y="400" width="40" height="50"/>
      <rect x="430" y="400" width="30" height="50"/>
    </g>

    <!-- Center White Hollow Square characteristic of Income Tax PAN QR codes -->
    <rect x="195" y="195" width="90" height="90" fill="#ffffff"/>
  </g>

  <!-- Security Microprint / Optical Guilloche Overlay -->
  <g opacity="0.35" transform="translate(680, 520)">
    <!-- Watermarked Dharma Chakra in center background -->
    <circle cx="80" cy="80" r="130" fill="none" stroke="#25588a" stroke-width="4"/>
    <circle cx="80" cy="80" r="105" fill="none" stroke="#25588a" stroke-width="1.5"/>
    <circle cx="80" cy="80" r="30" fill="none" stroke="#25588a" stroke-width="3"/>
    <line x1="80" y1="-50" x2="80" y2="210" stroke="#25588a" stroke-width="1.5"/>
    <line x1="-50" y1="80" x2="210" y2="80" stroke="#25588a" stroke-width="1.5"/>
    <line x1="-12" y1="-12" x2="172" y2="172" stroke="#25588a" stroke-width="1.5"/>
    <line x1="172" y1="-12" x2="-12" y2="172" stroke="#25588a" stroke-width="1.5"/>
  </g>
</svg>
